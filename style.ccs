/* Poster Wallpaper Background & Cyber Glow Mesh */
body.poster-bg {
    background-color: #010404 !important;
    background-image: 
        radial-gradient(circle at 50% 10%, rgba(6, 95, 70, 0.45) 0%, transparent 40%),
        radial-gradient(circle at 10% 80%, rgba(4, 47, 46, 0.3) 0%, transparent 50%),
        radial-gradient(circle at 90% 80%, rgba(6, 78, 59, 0.3) 0%, transparent 50%),
        linear-gradient(to bottom, #022c22 0%, #010404 100%) !important;
    background-attachment: fixed !important;
    background-size: cover !important;
}

/* Glassmorphism Cards matching terminal poster mockup */
.poster-card {
    background: rgba(2, 22, 17, 0.88) !important;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(16, 185, 129, 0.25);
    box-shadow: 0 10px 40px 0 rgba(0, 0, 0, 0.8), inset 0 0 15px rgba(16, 185, 129, 0.05);
}

/* Pulse animation for connection status badge */
.pulse-green {
    animation: pulseGreen 1.5s infinite;
}

@keyframes pulseGreen {
    0% { 
        box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); 
    }
    70% { 
        box-shadow: 0 0 0 8px rgba(16, 185, 129, 0); 
    }
    100% { 
        box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); 
    }
}

/* Glow effect for SVG line chart */
.chart-glow {
    filter: drop-shadow(0px 0px 10px rgba(16, 185, 129, 0.7));
}

/* Custom Scrollbar for Stream Feed Table */
::-webkit-scrollbar {
    width: 6px;
    height: 6px;
}

::-webkit-scrollbar-track {
    background: #010404;
}

::-webkit-scrollbar-thumb {
    background: #065f46;
    border-radius: 4px;
}

::-webkit-scrollbar-thumb:hover {
    background: #059669;
}
